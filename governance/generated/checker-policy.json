{
  "version": 1,
  "generatedFrom": [
    "governance/policy.yaml",
    "governance/domains.yaml",
    "governance/capabilities.yaml",
    "governance/actors.yaml"
  ],
  "verdicts": {
    "PASS": "Allowed.",
    "BLOCK": "Must be fixed before review.",
    "SPLIT": "Must be split into smaller tasks or PRs.",
    "HUMAN_DECISION": "Requires explicit human approval."
  },
  "principles": [
    {
      "id": "capability_not_obedience",
      "title": "Govern agents by capability, not by obedience.",
      "description": "Do not ask agents to behave. Constrain what they can read, write, execute, and escalate."
    },
    {
      "id": "layer_boundaries_by_default",
      "title": "Keep layer boundaries by default.",
      "description": "Horizontal layer boundaries are the default editing boundary because they limit implementation responsibility without introducing ambiguous product-boundary choices."
    },
    {
      "id": "named_junction_for_side_effect_crossings",
      "title": "Use small named junctions for side-effect crossings.",
      "description": "Junctions are for unavoidable crossings where side effects meet and the coordination itself has meaning. They are controlled exceptions, not a general architecture style."
    },
    {
      "id": "prefer_local_duplication_over_premature_shared_abstraction",
      "title": "Prefer local duplication over premature shared abstraction.",
      "description": "Boilerplate is acceptable when it preserves capability boundaries. Shared abstractions are privileged because they widen future change scope."
    }
  ],
  "domains": {
    "web_attention": {
      "description": "Web UI and client-side behavior for attention/supervision state.",
      "paths": ["apps/web/src/domains/attention/**"]
    },
    "web_task_list": {
      "description": "Web UI and client-side behavior for task list presentation.",
      "paths": ["apps/web/src/domains/task-list/**"]
    },
    "server_attention": {
      "description": "Server-side attention/supervision classification and persistence.",
      "paths": ["apps/server/src/domains/attention/**"]
    },
    "core_attention": {
      "description": "Shared core types and logic for attention/supervision state.",
      "paths": ["packages/core/src/domains/attention/**"]
    },
    "docs": {
      "description": "Documentation only.",
      "paths": ["README.md", "docs/**"]
    }
  },
  "protectedDomains": {
    "shared": {
      "description": "Shared code is privileged. Do not use it as a dumping ground.",
      "paths": ["apps/**/src/shared/**", "packages/shared/**"],
      "default_verdict": "HUMAN_DECISION"
    }
  },
  "capabilityProfiles": {
    "ui_patch": {
      "description": "Patch UI inside one granted domain.",
      "read": ["{domain}/**", "packages/core/src/domains/**/types/**"],
      "write": ["{domain}/ui/**", "{domain}/tests/**"],
      "execute": ["pnpm lint", "pnpm test"],
      "denied": ["package.json", "pnpm-lock.yaml", "package-lock.json", "apps/server/**"],
      "escalation": {
        "outside_write_scope": "HUMAN_DECISION",
        "dependency_change": "HUMAN_DECISION",
        "shared_change": "HUMAN_DECISION"
      }
    },
    "domain_logic_patch": {
      "description": "Patch logic inside one granted domain.",
      "read": ["{domain}/**", "packages/core/**"],
      "write": ["{domain}/logic/**", "{domain}/model/**", "{domain}/tests/**"],
      "execute": ["pnpm lint", "pnpm test", "pnpm typecheck"],
      "denied": ["package.json", "pnpm-lock.yaml", "package-lock.json"],
      "escalation": {
        "outside_write_scope": "HUMAN_DECISION",
        "dependency_change": "HUMAN_DECISION",
        "shared_change": "HUMAN_DECISION"
      }
    },
    "docs_only": {
      "description": "Documentation-only work.",
      "read": ["**/*"],
      "write": ["README.md", "docs/**"],
      "execute": [],
      "denied": ["package.json", "pnpm-lock.yaml", "package-lock.json", "apps/**", "packages/**"],
      "escalation": {"code_change": "BLOCK"}
    },
    "junction_integration": {
      "description": "Coordinate a small named junction where side effects meet and coordination semantics matter.",
      "requires_human_approval": true,
      "max_domains": 3,
      "max_changed_files": 8,
      "max_changed_lines": 400,
      "write": ["src/junctions/{junction}/**", "src/tests/junctions/{junction}.test.*", "docs/junctions/{junction}.md"],
      "readonly": ["src/core/**", "src/domains/**", "src/adapters/**", "src/runtime/**"],
      "required_declaration": [
        "junction_name",
        "participating_effects",
        "coordination_semantics",
        "execution_order",
        "failure_semantics",
        "retry_or_compensation_policy",
        "acceptance_criteria",
        "rollback_plan"
      ],
      "escalation": {
        "unnamed_cross_domain_work": "BLOCK",
        "outside_junction_boundary": "HUMAN_DECISION",
        "dependency_change": "HUMAN_DECISION",
        "shared_change": "HUMAN_DECISION"
      }
    },
    "vertical_slice": {
      "description": "Explicitly approved cross-domain feature work.",
      "requires_human_approval": true,
      "max_domains": 3,
      "max_changed_files": 8,
      "max_changed_lines": 400,
      "required_declaration": ["affected_domains", "reason", "acceptance_criteria", "rollback_plan", "split_plan"],
      "escalation": {
        "undeclared_domain": "BLOCK",
        "dependency_change": "HUMAN_DECISION",
        "shared_change": "HUMAN_DECISION"
      }
    }
  },
  "actors": {
    "docs_writer": {
      "description": "Documentation-only work.",
      "capability_profile": "docs_only",
      "default_domain": "docs",
      "write": ["README.md", "docs/**"],
      "denied": ["apps/**", "packages/**", "package.json", "pnpm-lock.yaml", "package-lock.json"],
      "escalation": {"code_change": "BLOCK"}
    },
    "ui_patcher": {
      "description": "Small UI-only changes inside one granted domain.",
      "capability_profile": "ui_patch",
      "requires_domain": true,
      "write": ["{domain}/ui/**", "{domain}/tests/**"],
      "denied": ["apps/server/**", "packages/core/**", "package.json", "pnpm-lock.yaml", "package-lock.json"],
      "escalation": {
        "outside_domain": "HUMAN_DECISION",
        "shared_change": "HUMAN_DECISION",
        "dependency_change": "HUMAN_DECISION"
      }
    },
    "domain_logic_patcher": {
      "description": "Logic/model changes inside one granted domain.",
      "capability_profile": "domain_logic_patch",
      "requires_domain": true,
      "write": ["{domain}/logic/**", "{domain}/model/**", "{domain}/tests/**"],
      "denied": ["apps/**/src/shared/**", "packages/shared/**", "package.json", "pnpm-lock.yaml", "package-lock.json"],
      "escalation": {
        "outside_domain": "HUMAN_DECISION",
        "shared_change": "HUMAN_DECISION",
        "dependency_change": "HUMAN_DECISION"
      }
    },
    "governance_editor": {
      "description": "Edit governance definitions, generation scripts, and checker logic.",
      "capability_profile": "governance_patch",
      "write": ["governance/**", "scripts/**", "package.json"],
      "escalation": {
        "dependency_change": "HUMAN_DECISION",
        "workflow_change": "HUMAN_DECISION"
      }
    },
    "junction_integrator": {
      "description": "Coordinate a small named junction across multiple domains when side effects meet and their coordination semantics matter.",
      "capability_profile": "junction_integration",
      "requires_human_approval": true,
      "write": ["src/junctions/{junction}/**", "src/tests/junctions/{junction}.test.*", "docs/junctions/{junction}.md"],
      "readonly": ["src/core/**", "src/domains/**", "src/adapters/**", "src/runtime/**"],
      "limits": {"max_domains": 3, "max_changed_files": 8, "max_changed_lines": 400},
      "required_declaration": [
        "junction_name",
        "participating_domains",
        "participating_effects",
        "coordination_semantics",
        "execution_order",
        "failure_semantics",
        "compensation_or_retry_policy",
        "acceptance_criteria",
        "rollback_plan"
      ],
      "forbidden_mix": ["feature_change + unrelated_refactor", "dependency_change + junction_change", "formatting_cleanup + behavior_change"],
      "escalation": {
        "unnamed_cross_domain_work": "BLOCK",
        "outside_junction_boundary": "HUMAN_DECISION",
        "shared_change": "HUMAN_DECISION",
        "dependency_change": "HUMAN_DECISION"
      }
    },
    "vertical_slice_worker": {
      "description": "Cross-domain feature work with explicit human approval.",
      "capability_profile": "vertical_slice",
      "requires_human_approval": true,
      "required_declaration": ["affected_domains", "reason", "rollback_plan"],
      "escalation": {
        "undeclared_domain": "BLOCK",
        "shared_change": "HUMAN_DECISION",
        "dependency_change": "HUMAN_DECISION"
      }
    }
  },
  "rules": [
    {
      "id": "one_primary_layer_boundary",
      "title": "One task, one primary layer boundary unless it is a named junction.",
      "type": "layer_count",
      "verdict": "SPLIT",
      "maxLayers": 1,
      "exceptions": ["junction_integration", "vertical_slice", "api_contract_update"]
    },
    {
      "id": "one_primary_domain",
      "title": "One task, one primary domain.",
      "type": "domain_count",
      "verdict": "SPLIT",
      "maxDomains": 1,
      "exceptions": ["vertical_slice", "api_contract_update", "junction_integration"]
    },
    {
      "id": "granted_write_scope_only",
      "title": "Write only inside granted paths.",
      "type": "write_scope",
      "verdict": "BLOCK",
      "exceptions": []
    },
    {
      "id": "shared_requires_approval",
      "title": "Shared changes require approval.",
      "type": "protected_domain",
      "verdict": "HUMAN_DECISION",
      "domains": ["shared"],
      "exceptions": []
    },
    {
      "id": "dependency_requires_approval",
      "title": "Dependency changes require approval.",
      "type": "path_match",
      "verdict": "HUMAN_DECISION",
      "paths": ["package.json", "pnpm-lock.yaml", "package-lock.json"],
      "exceptions": []
    },
    {
      "id": "generated_files_readonly",
      "title": "Generated files are read-only.",
      "type": "path_match",
      "verdict": "BLOCK",
      "paths": ["**/generated/**", "TODO.md", "CONTEXT.md", "THREADS.md"],
      "exceptions": []
    },
    {
      "id": "side_effect_crossing_requires_named_junction",
      "title": "Side-effect crossings require a named junction.",
      "type": "declaration_required",
      "verdict": "HUMAN_DECISION",
      "exceptions": []
    },
    {
      "id": "junction_is_controlled_exception",
      "title": "A junction is a controlled exception.",
      "type": "declaration_required",
      "verdict": "HUMAN_DECISION",
      "exceptions": []
    },
    {
      "id": "escalate_when_scope_is_insufficient",
      "title": "Request escalation instead of expanding scope.",
      "type": "escalation_required",
      "verdict": "HUMAN_DECISION",
      "exceptions": []
    }
  ]
}
